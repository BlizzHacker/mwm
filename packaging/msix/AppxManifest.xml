<?xml version="1.0" encoding="utf-8"?>
<!--
  MDW - Move Digital Weight: Microsoft Store (MSIX) manifest.
  Identity Name / Publisher MUST match the reservation in Partner Center
  (Product identity page) or the upload is rejected. Publisher below is the
  MOVEWEIGHT seller account; Name is the expected reservation name.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop6 rescap">

  <Identity
    Name="MOVEWEIGHT.MDWMoveDigitalWeight"
    Publisher="CN=6375D74B-5E4F-45B4-B246-B29507C1332A"
    Version="__VERSION__.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MDW - Move Digital Weight</DisplayName>
    <PublisherDisplayName>MOVEWEIGHT</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Free, open-source PC cleaner and uninstaller. Clean junk and browser caches, uninstall programs with leftover removal, manage startup apps and services, update software via winget, find duplicates, analyze disk space and securely delete files.</Description>
    <!-- A cleaner must see the real AppData/registry, not a per-package copy. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="MDW" Executable="MoveDigitalWeight.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MDW - Move Digital Weight"
        Description="Clean junk, uninstall cleanly, tame startup."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="MDW" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Justification for certification: system cleaner must write the real
         user profile and registry (FileSystem/RegistryWriteVirtualization off). -->
    <rescap:Capability Name="unvirtualizedResources" />
    <!-- "Restart as administrator" for Windows\Temp, services, HKLM startup. -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
