[Unit]
Description=Inventory and optionally update Proxmox hosts through MWM
Wants=network-online.target
After=network-online.target
ConditionPathExists=/usr/bin/pvesh

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/mwm-pve-updates auto --refresh
TimeoutStartSec=4h
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
